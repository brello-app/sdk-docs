{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Brello",
  "colors": {
    "primary": "#2e31ff",
    "light": "#1f62ff",
    "dark": "#2667ff"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "guides/authentication"]
          },
          {
            "group": "Send usage data",
            "pages": ["guides/events", "guides/end-users", "guides/privacy", "guides/errors"]
          },
          {
            "group": "Build integrations",
            "pages": ["guides/read-api", "guides/webhooks"]
          }
        ]
      },
      {
        "tab": "TypeScript",
        "groups": [
          {
            "group": "TypeScript SDK",
            "pages": [
              "typescript/quickstart",
              "typescript/openai",
              "typescript/anthropic",
              "typescript/google",
              "typescript/configuration"
            ]
          }
        ]
      },
      {
        "tab": "Python",
        "groups": [
          {
            "group": "Python SDK",
            "pages": [
              "python/quickstart",
              "python/openai",
              "python/anthropic",
              "python/google",
              "python/configuration"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "SDK API",
            "pages": ["api-reference/introduction", "api-reference/events", "api-reference/config"]
          },
          {
            "group": "Read API",
            "pages": ["api-reference/spend", "api-reference/end-users", "api-reference/reports", "api-reference/latest-report", "api-reference/report", "api-reference/report-pdf"]
          },
          {
            "group": "Project management",
            "pages": ["api-reference/list-api-keys", "api-reference/create-api-key", "api-reference/revoke-api-key", "api-reference/list-webhook-subscriptions", "api-reference/set-webhook-subscription"]
          },
          {
            "group": "Webhook events",
            "pages": ["api-reference/report-ready", "api-reference/alert-abuse", "api-reference/alert-model-change"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Service status",
          "href": "https://status.brello.app",
          "icon": "signal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@brello.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Brello",
      "href": "https://brello.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "playground": {
      "display": "none"
    }
  }
}

{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Brello",
  "colors": {
    "primary": "#2e31ff",
    "light": "#1f62ff",
    "dark": "#2667ff"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "guides/authentication"]
          },
          {
            "group": "Send usage data",
            "pages": ["guides/events", "guides/end-users", "guides/privacy", "guides/errors"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "SDK API",
            "pages": ["api-reference/introduction", "api-reference/events", "api-reference/config"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Service status",
          "href": "https://status.brello.app",
          "icon": "signal"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@brello.app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Brello",
      "href": "https://brello.app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "api": {
    "playground": {
      "display": "none"
    }
  }
}
